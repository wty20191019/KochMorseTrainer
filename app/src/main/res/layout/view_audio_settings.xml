<?xml version="1.0" encoding="utf-8"?>
<!-- 公共设置区：等级 + 音频参数（各页 include 复用，实例彼此独立） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 等级选择 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="等级:"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#333333" />

        <TextView
            android:id="@+id/tvCurrentChars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" K M"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- 音频参数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <!-- 字符速度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="字符速度"
                android:textColor="#CCCCCC" />

            <SeekBar
                android:id="@+id/seekBarCharSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:max="45"
                android:progress="15" />

            <TextView
                android:id="@+id/tvCharSpeedValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="20"
                android:textColor="#FFFFFF"
                android:gravity="center" />
        </LinearLayout>

        <!-- 有效速度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="有效速度"
                android:textColor="#CCCCCC" />

            <SeekBar
                android:id="@+id/seekBarEffSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:max="35"
                android:progress="5" />

            <TextView
                android:id="@+id/tvEffSpeedValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="10"
                android:textColor="#FFFFFF"
                android:gravity="center" />
        </LinearLayout>

        <!-- 音调 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="音调 (Hz)"
                android:textColor="#CCCCCC" />

            <SeekBar
                android:id="@+id/seekBarFreq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:max="1400"
                android:progress="200" />

            <TextView
                android:id="@+id/tvFreqValue"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="600"
                android:textColor="#FFFFFF"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
